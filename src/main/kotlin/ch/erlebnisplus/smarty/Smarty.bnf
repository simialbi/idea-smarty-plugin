{
  parserClass="ch.erlebnisplus.smarty.parser.SmartyParser"
  // No parserUtilClass: the grammar has no external or meta rules, so the generated parser
  // only needs the platform's GeneratedParserUtilBase, which Grammar-Kit imports by default.

  elementTypeHolderClass="ch.erlebnisplus.smarty.psi.SmartyTypes"
  elementTypeClass="ch.erlebnisplus.smarty.psi.SmartyElementType"
  tokenTypeClass="ch.erlebnisplus.smarty.psi.SmartyTokenType"

  psiPackage="ch.erlebnisplus.smarty.psi"
  psiImplPackage="ch.erlebnisplus.smarty.psi.impl"
  psiImplUtilClass="ch.erlebnisplus.smarty.psi.impl.SmartyPsiImplUtil"

  tokens = [
    // Delimiters
    LDELIM = "{"
    RDELIM = "}"

    // Operators
    ASSIGN = "="
    PIPE = "|"
    DOT = "."
    ARROW = "->"
    COMMA = ","
    SEMICOLON = ";"
    COLON = ":"
    DOUBLE_COLON = "::"
    QUESTION = "?"

    // Brackets
    LPAREN = "("
    RPAREN = ")"
    LBRACKET = "["
    RBRACKET = "]"

    // Arithmetic operators
    PLUS = "+"
    MINUS = "-"
    MULT = "*"
    DIV = "/"
    MOD = "%"
    MOD_KEYWORD = "mod"
    DIV_KEYWORD = "div"

    // Comparison operators
    EQ = "=="
    NEQ = "!="
    EQEQ = "==="
    NEQEQ = "!=="
    LT = "<"
    GT = ">"
    LE = "<="
    GE = ">="

    // Textual equivalents of the comparison operators. The lexer also accepts the second
    // spelling where Smarty documents one: ne for neq, ge for gte, le for lte.
    // https://smarty-php.github.io/smarty/stable/designers/language-basic-syntax/language-syntax-operators
    EQ_KEYWORD = "eq"
    NEQ_KEYWORD = "neq"
    LT_KEYWORD = "lt"
    GT_KEYWORD = "gt"
    LE_KEYWORD = "lte"
    GE_KEYWORD = "gte"

    // Regular expression match: {if $a matches "/^[a-z]+$/"}, PHP's preg_match($b, $a).
    // It has no symbolic spelling, so it is a comparison operator that only exists as a word.
    MATCHES = "matches"

    // Logical operators
    AND = "&&"
    OR = "||"
    NOT = "!"
    AND_KEYWORD = "and"
    OR_KEYWORD = "or"
    NOT_KEYWORD = "not"

    // Keywords
    IF = "if"
    ELSE = "else"
    ELSEIF = "elseif"
    FOREACH = "foreach"
    FOREACHELSE = "foreachelse"
    FOR = "for"
    WHILE = "while"
    SECTION = "section"
    SECTIONELSE = "sectionelse"
    SWITCH = "switch"
    CASE = "case"
    DEFAULT = "default"
    BREAK = "break"
    CONTINUE = "continue"
    BLOCK = "block"
    FUNCTION = "function"
    CALL = "call"
    EXTENDS = "extends"
    INCLUDE = "include"
    INSERT = "insert"
    ASSIGN_KW = "assign"
    APPEND = "append"
    PREPEND = "prepend"
    CAPTURE = "capture"
    CONFIG_LOAD = "config_load"
    DEBUG = "debug"
    LITERAL_KW = "literal"
    NOCACHE = "nocache"
    SETFILTER = "setfilter"
    STRIP = "strip"
    LDELIM_KW = "ldelim"
    RDELIM_KW = "rdelim"

    // Modifiers
    UPPER = "upper"
    LOWER = "lower"
    CAPITALIZE = "capitalize"
    CAT = "cat"
    COUNT_PARAGRAPHS = "count_paragraphs"
    COUNT_SENTENCES = "count_sentences"
    COUNT_WORDS = "count_words"
    DATE_FORMAT = "date_format"
    ESCAPE = "escape"
    FROM_CHARSET = "from_charset"
    INDENT = "indent"
    NL2BR = "nl2br"
    REGEX_REPLACE = "regex_replace"
    REPLACE = "replace"
    SPACIFY = "spacify"
    STRING_FORMAT = "string_format"
    STRIP_TAGS = "strip_tags"
    TO_CHARSET = "to_charset"
    TRUNCATE = "truncate"
    UNESCAPE = "unescape"
    WORDWRAP = "wordwrap"

    // Special
    AT = "@"
    DOLLAR = "$"
    HASH = "#"
    FAT_ARROW = "=>"

    // Literals produced by the lexer
    TRUE = "true"
    FALSE = "false"
    NULL_LITERAL = "null"

    // Produced by the lexer only, never written in a rule
    TEXT = "text"
    WS = "ws"
    BAD_CHARACTER = "bad_character"

    // Token patterns
    comment = "regexp://.*"
    identifier = "regexp:[a-zA-Z_]\w*"
    number = "regexp:\d+(\.\d*)?([eE][+-]?\d+)?"
    string = "regexp:(\"([^\"\\\\]|\\\\.)*\"|'([^'\\\\]|\\\\.)*')"
    whitespace = "regexp:\s+"
  ]

  name(".*_expr")="expression"
  extends(".*_expr")=expr

  pin(".*_list")=1
}

// ============================================================================
// ROOT RULE
// ============================================================================

root_rule ::= template_item*

private template_item ::=
    smarty_tag
    | text_content

// Everything outside a tag, markup included. There is no separate rule for HTML: the lexer emits
// one token type for template data so that the platform can later hand that data to the HTML
// parser as a second PSI root. Splitting markup out here would defeat that.
//
// One node per token, deliberately. The lexer's rule is `[^{]+`, so two TEXT tokens can never abut
// and a `+` here could only ever fold runs together *around a skipped comment* - which is exactly
// what it did: `<div>{* note *}<p>x</p>` put the PsiComment inside a single TEXT_CONTENT as an
// interior leaf, SmartyBlock dropped that composite in favour of the data language's blocks, and
// nothing was left to cover the comment ("nonempty text is not covered by block"). Ending the node
// at the comment leaves it a sibling at file level, where it gets a block of its own.
text_content ::= TEXT

// ============================================================================
// SMARTY TAGS & COMMENTS
// ============================================================================

// One bad tag costs one tag, and nothing else.
//
// Without a recovery rule the parser stops at the first token it cannot place and the root's own
// eat-more swallows everything after it into a single error element. Every Variable node past that
// point stops existing, so SmartyAnnotator stops colouring variable names and only the lexer's `$`
// is left - which is the whole of the "only the dollar sign is coloured" report. Smarty's plugin
// namespace is open, so no grammar can be complete and this has to be survivable.
//
// The recovery belongs on *this* rule and on none of the four below, which is the opposite of what
// it looks like it should be. `recoverWhile` runs whenever its rule fails, whether or not the rule
// had committed to anything - and the first three alternatives fail on nearly every tag there is,
// after consuming the `{`. Attached to them, `{$x}` went like this: `smarty_literal_block` consumed
// `{`, missed `literal`, rolled back, and its recovery then ate the entire file as error content
// before `smarty_function_call` was ever tried. Attached here the rule cannot misfire, because a
// `{` always ends up in the pinned `smarty_function_call` and so this rule always succeeds; the
// recovery is reached only with the tag closed and the parser standing on the junk after it.
//
// The predicate is a negative lookahead and consumes nothing: it only tells the generated recovery
// loop to keep skipping while the next token can neither open a tag nor be template data. RDELIM is
// deliberately absent - stopping at `}` would leave a stray `}` at top level that no template_item
// can start with, the root loop would end there, and the rest of the file would be swallowed
// exactly as before. On a tag that parsed, the next token is always `{`, TEXT or the end of the
// file, so the predicate fails and recovery is a no-op.
smarty_tag ::=
    smarty_literal_block
    | smarty_nocache_block
    | smarty_closing_tag
    | smarty_function_call
    {recoverWhile=tag_recover}

private tag_recover ::= !('{' | TEXT)

// Closing tags are matched flat rather than as a nesting construct: the features built on this
// PSI locate declarations by type, none of them need the block structure.
smarty_closing_tag ::= '{' '/' closing_keyword '}' {pin=2}

private closing_keyword ::=
    IF | FOREACH | FOR | WHILE | SECTION | SWITCH | BLOCK | FUNCTION
    | CAPTURE | STRIP | SETFILTER | NOCACHE | LITERAL_KW

// No rule for comments: the parser definition reports COMMENT as a comment token, so the
// builder skips it and the platform turns it into a PsiComment leaf of its own.

smarty_literal_block ::=
    '{' LITERAL_KW '}' TEXT* '{' '/' LITERAL_KW '}'
    {pin=2 methods=[getLiteralContent]}

smarty_nocache_block ::= '{' NOCACHE '}' TEXT* '{' '/' NOCACHE '}' {pin=2}

// ============================================================================
// FUNCTION CALLS & STATEMENTS
// ============================================================================

smarty_function_call ::= '{' function_body '}' {pin=1}

function_body ::=
    if_statement
    | elseif_statement
    | else_statement
    | foreach_statement
    | foreachelse_statement
    | for_statement
    | while_statement
    | section_statement
    | sectionelse_statement
    | switch_statement
    | case_statement
    | break_statement
    | continue_statement
    | block_statement
    | function_statement
    | call_statement
    | extends_statement
    | include_statement
    | insert_statement
    | assign_statement
    | append_statement
    | capture_statement
    | config_load_statement
    | debug_statement
    | setfilter_statement
    | strip_statement
    | ldelim_rdelim_statement
    | plugin_call_statement
    | variable_output

// ============================================================================
// CONTROL STRUCTURES
// ============================================================================

if_statement ::= IF expr assign_clause* {pin=1}

elseif_statement ::= ELSEIF expr assign_clause* {pin=1}

else_statement ::= ELSE {pin=1}

foreach_statement ::=
    FOREACH [expr AS variable [FAT_ARROW variable]] assign_clause*
    {pin=1 name="foreach loop" methods=[getForeachVariable getForeachItems getForeachValueVar getForeachKeyVar]}

foreachelse_statement ::= FOREACHELSE {pin=1}

for_statement ::=
    FOR for_init ';' for_condition ';' for_increment assign_clause*
    {pin=1 name="for loop"}

private for_init ::= assignment
private for_condition ::= expr
private for_increment ::= assignment

while_statement ::= WHILE expr assign_clause* {pin=1 name="while loop"}

// Both spellings: the attribute form every real template is written in,
// {section name="rows" loop=$rows}, and the bare form {section rows loop=$rows}.
//
// The attribute alternative has to come first. The generated parser never backtracks into an
// alternative that succeeded, so with the bare form first `name` would match IDENTIFIER, the `=`
// would be left over and the tag would fail all over again.
// https://smarty-php.github.io/smarty/stable/designers/language-builtin-functions/language-function-section
section_statement ::=
    SECTION (attribute_clause+ | IDENTIFIER assign_clause*)
    {pin=1 name="section loop"}

sectionelse_statement ::= SECTIONELSE {pin=1}

switch_statement ::= SWITCH expr {pin=1}

case_statement ::= CASE case_value {pin=1}

private case_value ::= expr | DEFAULT

break_statement ::= BREAK [NUMBER]

continue_statement ::= CONTINUE [NUMBER]

// ============================================================================
// BLOCK & FUNCTION DEFINITIONS
// ============================================================================

block_statement ::=
    BLOCK declaration_name [APPEND | PREPEND] assign_clause*
    {
      pin=1
      mixin="ch.erlebnisplus.smarty.psi.impl.SmartyNamedElementImpl"
      implements="ch.erlebnisplus.smarty.psi.SmartyNamedElement"
      methods=[getName setName getNameIdentifier getPresentation]
    }

// Named for the same reason a block is: {function name="box"} declares something the rest of the
// project navigates to. Both rules read their name through declaration_name, so they share the
// helpers in SmartyPsiImplUtil.
function_statement ::=
    FUNCTION declaration_name [FUNCTION_PARAMS] assign_clause*
    {
      pin=1
      mixin="ch.erlebnisplus.smarty.psi.impl.SmartyNamedElementImpl"
      implements="ch.erlebnisplus.smarty.psi.SmartyNamedElement"
      methods=[getName setName getNameIdentifier getPresentation]
    }

// Both the attribute form used by nearly every real template - {block name="content"} - and the
// bare form {block content}.
private declaration_name ::= (IDENTIFIER '=' name_value) | name_value

private name_value ::= IDENTIFIER | STRING

private FUNCTION_PARAMS ::= LPAREN param_list RPAREN
private param_list ::= IDENTIFIER (',' IDENTIFIER)*

call_statement ::= CALL template_reference [call_arguments] {pin=1}

private template_reference ::= (IDENTIFIER | STRING) ('.' IDENTIFIER)*
private call_arguments ::= LPAREN [assign_list] RPAREN

// ============================================================================
// INCLUDE & EXTEND STATEMENTS
// ============================================================================

extends_statement ::= EXTENDS [STRING] assign_clause* {pin=1 mixin="ch.erlebnisplus.smarty.psi.impl.SmartyReferenceHostImpl"}

include_statement ::=
    INCLUDE [STRING] assign_clause* [NOCACHE]
    {pin=1 mixin="ch.erlebnisplus.smarty.psi.impl.SmartyReferenceHostImpl"}

insert_statement ::=
    INSERT [STRING | IDENTIFIER] assign_clause*
    {pin=1 mixin="ch.erlebnisplus.smarty.psi.impl.SmartyReferenceHostImpl"}

// ============================================================================
// ASSIGNMENT STATEMENTS
// ============================================================================

// Both tags come in two spellings. The classic one names its parts, {assign var="total" value=0},
// and is what most templates are written in; the shorthand {assign $total = 0} came with Smarty 3.
//
// `var`, `value`, `index` and `scope` stay ordinary identifiers to the lexer. A token of their own
// would take those words away from every other position an identifier can hold - {$var} and
// {$value} are not rare things to write - so the attribute form is matched structurally, the way
// declaration_name matches {block name="content"}, and which attribute is which is read from the
// PSI in SmartyPsiImplUtil.
// https://smarty-php.github.io/smarty/stable/designers/language-builtin-functions/language-function-assign
assign_statement ::=
    ASSIGN_KW (assign_shorthand | attribute_clause+)
    {pin=1 name="assign statement" methods=[getAssignTarget getAssignValue]}

// {append} takes the same two forms. Its extra attribute, `index`, needs nothing here: it is an
// attribute like any other.
// https://smarty-php.github.io/smarty/stable/designers/language-builtin-functions/language-function-append
append_statement ::=
    APPEND (assign_shorthand | attribute_clause+)
    {pin=1 name="append statement" methods=[getAssignTarget getAssignValue]}

private assign_shorthand ::= variable '=' expr assign_clause*

// An attribute of the classic form. `nocache` is repeated on its own because it is also valid as a
// bare flag: {assign var="x" value=1 nocache}.
private attribute_clause ::= attribute_name '=' expr | NOCACHE

// All three spellings: {capture}, which captures into `default`, the shorthand {capture $var}, and
// the attribute form {capture name="x" assign="out"}. The order is free here - `variable` starts
// with a `$`, which no attribute_clause can match.
// https://smarty-php.github.io/smarty/stable/designers/language-builtin-functions/language-function-capture
capture_statement ::=
    CAPTURE [variable assign_clause* | attribute_clause+]
    {pin=1 name="capture statement"}

// The tag that makes config variables available. Its `section` and `scope` attributes are keyword
// tokens to the lexer; attribute_name is what lets them through.
// https://smarty-php.github.io/smarty/stable/designers/language-builtin-functions/language-function-config-load
config_load_statement ::=
    CONFIG_LOAD [STRING] assign_clause*
    {pin=1}

debug_statement ::= DEBUG [DEBUG_VARS] {pin=1}

private DEBUG_VARS ::= (IDENTIFIER | variable) (',' (IDENTIFIER | variable))*

setfilter_statement ::=
    SETFILTER modifier_list
    {pin=1}

// {/strip} was already a closing_keyword; the opening tag had no rule at all, so a template that
// used it lost everything after it.
// https://smarty-php.github.io/smarty/stable/designers/language-builtin-functions/language-function-strip
strip_statement ::= STRIP {pin=1}

ldelim_rdelim_statement ::=
    LDELIM_KW | RDELIM_KW

// A tag with no rule of its own: {html_options values=$a}, {mailto address=$to}, and whatever the
// project's own plugin directory holds. Smarty resolves the name against its plugin directories at
// render time, so the set is open and no grammar can enumerate it; an identifier followed by at
// least one attribute is the shape they all share.
//
// It sits last in function_body so that every builtin still matches its own rule first, and it
// requires an attribute so that a bare {foo} stays a variable_output.
// https://smarty-php.github.io/smarty/stable/designers/language-custom-functions/
plugin_call_statement ::=
    IDENTIFIER attribute_clause+
    {pin=2 name="plugin call"}

// ============================================================================
// VARIABLE OUTPUT
// ============================================================================

// A modifier chain is no longer part of this rule: it belongs to the value it modifies, at the
// tightest binding level of the expression grammar, so that it can also be written on an attribute
// value ({assign var="x" value=$y|escape}) or on one operand of a larger expression
// ({$a + $b|round}). See modified_expr.
variable_output ::=
    expr
    {pin=1}

// `@` is the array-modifier prefix: {$rows|@count} applies count() to the array itself rather than
// to each of its elements.
modifier ::=
    PIPE [AT] modifier_name [modifier_arguments]
    {pin=1 methods=[getModifierName getModifierParams]}

// `default` is why this cannot be a list of tokens: the lexer hands "default" to the `switch`
// keyword long before a modifier rule is reached, which made the DEFAULT_MOD token unreachable and
// {$title|default:"n/a"} unparsable. Any PHP function may be used as a modifier, so any word has to
// be accepted here.
// https://smarty-php.github.io/smarty/stable/designers/language-modifiers/
private modifier_name ::= attribute_name

// Modifier parameters are colon separated, one colon per parameter:
// {$text|truncate:30:"...":true}. The rule used to allow a single colon followed by commas,
// which is neither what Smarty documents nor what getModifierParams already reads, so anything
// past the first parameter failed to parse.
private modifier_arguments ::=
    (COLON modifier_param)+

// A parameter is a value, not a whole expression. Parsing it as one makes it greedy and it eats the
// rest of the chain: `{$a|default:"-"|escape}` would attach `escape` to `"-"` instead of to `$a`,
// which parses without complaint but builds the wrong tree and makes the annotator count the tail as
// parameters of `default`. Stopping below modified_expr is what keeps a chain a chain. A sign is
// allowed because {$n|truncate:-1} is written that way.
private modifier_param ::=
    [PLUS | MINUS] postfix_expr

// ============================================================================
// EXPRESSIONS
// ============================================================================

expr ::=
    ternary_expr {methods=[getOperator isLiteral]}

private ternary_expr ::=
    logical_or_expr (QUESTION expr COLON expr)?

private logical_or_expr ::=
    logical_and_expr ((OR | OR_KEYWORD) logical_and_expr)*

private logical_and_expr ::=
    logical_not_expr ((AND | AND_KEYWORD) logical_not_expr)*

private logical_not_expr ::=
    ((NOT | NOT_KEYWORD) logical_not_expr)
    | comparison_expr

private comparison_expr ::=
    additive_expr (comparison_operator additive_expr)*

// MATCHES sits with the comparison operators because that is how Smarty documents it and how it
// reads - {if $a matches "/re/" && $b} groups the way the && suggests.
private comparison_operator ::=
    EQ | NEQ | EQEQ | NEQEQ | LT | GT | LE | GE
    | EQ_KEYWORD | NEQ_KEYWORD | LT_KEYWORD | GT_KEYWORD | LE_KEYWORD | GE_KEYWORD
    | MATCHES

private additive_expr ::=
    multiplicative_expr ((PLUS | MINUS) multiplicative_expr)*

private multiplicative_expr ::=
    unary_expr ((MULT | DIV | MOD | MOD_KEYWORD | DIV_KEYWORD) unary_expr)*

private unary_expr ::=
    ((PLUS | MINUS | NOT | NOT_KEYWORD) unary_expr)
    | modified_expr

// A modifier binds to the value in front of it, not to the expression around it: {if $rows|count > 0}
// compares the modified value, and {assign var="x" value=$y|escape} assigns the modified one. So the
// chain lives at the tightest binding level, which is also what makes `{$a + $b|round}` mean
// `$a + ($b|round)`, the way Smarty's own compiler reads it.
private modified_expr ::=
    postfix_expr modifier*

private postfix_expr ::=
    primary_expr (postfix_op)*

private postfix_op ::=
    member_access
    | array_access

private primary_expr ::=
    variable
    | literal
    | function_call
    | config_variable
    | LPAREN expr RPAREN
    | IDENTIFIER

// ============================================================================
// VARIABLES & MEMBER ACCESS
// ============================================================================

variable ::= DOLLAR variable_name {methods=[getName hasArrayAccess getArrayIndices getPropertyChain]}

// A variable may be named after a keyword - {$section}, {$default}, {$include} and {$call} are all
// perfectly ordinary template variables - and nothing can be confused by it, because after a `$`
// only a name can follow.
private variable_name ::=
    (IDENTIFIER | keyword_name) member_access*

// One step of an access chain. `{$smarty.section.rows.index}` and `{$smarty.capture.default}` need
// the keywords, `{$smarty.config.$key}` needs a variable as the step, and `{$row@index}` is the
// loop-property separator - a different `@` from the array-modifier prefix of `{$rows|@count}`,
// which belongs to the modifier.
//
// `::` reaches a static class member. Nothing declares that the thing in front of it is a class:
// `{DynamicModal::SIZE}` is an ordinary `IDENTIFIER` from `primary_expr` with this step behind it,
// the same shape `{$object->property}` has behind its variable.
//
// The call form comes first, and has to: on `{$this->head}` it fails at the missing `(` before its
// pin and the plain step matches instead, but with the plain step first it would match `head` and
// leave the parentheses to whatever follows - which is the reported error.
// https://smarty-php.github.io/smarty/stable/designers/language-variables/language-variables-smarty
// https://smarty-php.github.io/smarty/stable/api/configuration/#static-classes
member_access ::=
    method_call
    | DOT property_name
    | ARROW property_name
    | DOUBLE_COLON property_name
    | AT property_name
    | array_access

// A method on an object or a static method on a class: `{$this->head()}`, `{Foo::bar($x)}`.
//
// It is its own element rather than a `function_call` behind a separator, because the two are not
// the same thing to anything that reads the tree: a `function_call` names a Smarty or PHP function
// that `SmartyBuiltins` knows and `{function}` declarations can be searched for, and a method name
// belongs to a class this plugin never sees. The pin is on the `(`, so once a call is under way a
// missing `)` is reported inside the call instead of dropping the whole step.
method_call ::=
    (ARROW | DOUBLE_COLON) property_name LPAREN [argument_list] RPAREN
    {pin=3 methods=[getMethodName getMethodArguments]}

private property_name ::=
    IDENTIFIER
    | variable
    | keyword_name

array_access ::=
    LBRACKET array_index RBRACKET

private array_index ::=
    expr
    | IDENTIFIER
    | NUMBER

// The one kind of variable Smarty does not spell with a `$`: config variables come from the file
// a {config_load} read and are written between hash marks. The rule that used to stand here was
// `AT IDENTIFIER`, which is not Smarty syntax at all - `@` is the array-modifier prefix of
// `{$rows|@count}` and the loop-property separator of `{$item@index}`, and both of those now sit
// where they belong, on `modifier` and on `member_access`.
//
// Nothing further is needed for `{#foo#[1]}` or `{#foo#|escape}`: an index follows from
// `postfix_expr`, a modifier from `modified_expr`, exactly as for a `$` variable.
//
// https://smarty-php.github.io/smarty/stable/designers/language-variables/language-config-variables/
config_variable ::= HASH config_variable_name HASH {pin=1}

/* Either the name itself, or a variable holding it - `{#$section#}` reads the config key whose
   name is the value of `$section`. */
private config_variable_name ::=
    IDENTIFIER
    | variable

// ============================================================================
// FUNCTION CALLS
// ============================================================================

function_call ::=
    function_name LPAREN [argument_list] RPAREN {methods=[getFunctionName getFunctionArguments isBuiltinFunction]}

private function_name ::=
    IDENTIFIER

argument_list ::=
    named_argument (',' named_argument)*
    | positional_argument (',' positional_argument)*

private named_argument ::=
    attribute_name '=' expr

private positional_argument ::=
    expr

// ============================================================================
// LITERALS
// ============================================================================

literal ::=
    NUMBER
    | STRING
    | BOOLEAN
    | NULL_LITERAL
    | ARRAY_LITERAL

// The lexer already folds yes/on into TRUE and no/off into FALSE.
private BOOLEAN ::= TRUE | FALSE

ARRAY_LITERAL ::=
    LBRACKET [array_element_list] RBRACKET

private array_element_list ::=
    array_element (',' array_element)* [COMMA]

private array_element ::=
    (expr '=>')? expr

// ============================================================================
// MISCELLANEOUS RULES
// ============================================================================

private assignment ::= variable ASSIGN expr

// Every word this lexer has a keyword token for, usable as a name.
//
// Smarty puts these words exactly where the grammar wants an identifier - {include ... assign="x"},
// {config_load ... section="setup"}, {html_options ... escape=false},
// {$smarty.section.rows.index}, {$title|default:"n/a"} - and a rule that only accepts IDENTIFIER
// rejects working templates and takes the rest of the file down with them. The previous fix was one
// rule per collision; this is the general one.
//
// Admitting them is safe because every position that uses this rule either follows a `$`, a `.` or
// a `|`, where nothing else can stand, or is followed by `=` or `:`: a keyword that opens a tag
// cannot be mistaken for a name, because a name without its separator fails the alternative and the
// parser moves on. The operator words - and, or, not, eq, mod, matches, ... - are deliberately
// absent: no Smarty tag names an attribute after them, and keeping them out keeps the expression
// rules unambiguous. So are true, false and null, which are values in their own right.
private keyword_name ::=
    IF | ELSE | ELSEIF | FOREACH | FOREACHELSE | FOR | WHILE | SECTION | SECTIONELSE
    | SWITCH | CASE | DEFAULT | BREAK | CONTINUE | BLOCK | FUNCTION | CALL | EXTENDS
    | INCLUDE | INSERT | ASSIGN_KW | APPEND | PREPEND | CAPTURE | CONFIG_LOAD | DEBUG
    | LITERAL_KW | NOCACHE | SETFILTER | STRIP | LDELIM_KW | RDELIM_KW | AS
    | UPPER | LOWER | CAPITALIZE | CAT | COUNT_PARAGRAPHS | COUNT_SENTENCES | COUNT_WORDS
    | DATE_FORMAT | ESCAPE | FROM_CHARSET | INDENT | NL2BR | REGEX_REPLACE | REPLACE
    | SPACIFY | STRING_FORMAT | STRIP_TAGS | TO_CHARSET | TRUNCATE | UNESCAPE | WORDWRAP

private attribute_name ::=
    IDENTIFIER
    | keyword_name

private assign_clause ::=
    attribute_name '=' expr

private assign_list ::=
    assign_clause (',' assign_clause)*

private modifier_list ::=
    modifier (',' modifier)*
