<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>ch.erlebnisbank.smarty</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Smarty</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.erlebnisbank.ch">Erlebnisbank</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Enter short description for your plugin here.<br>
        <em>most HTML tags may be used</em>
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <!-- HTML and XML PSI. There is no com.intellij.modules.html in 2025.3 - HTML support is part
         of the XML module, and depending on a module that does not exist silently disables the
         whole plugin. -->
    <depends>com.intellij.modules.xml</depends>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Smarty Template" implementationClass="ch.erlebnisbank.smarty.SmartyFileType" fieldName="INSTANCE"
                  language="Smarty" extensions="tpl" />
        <lang.parserDefinition language="Smarty" implementationClass="ch.erlebnisbank.smarty.SmartyParserDefinition" />
        <lang.syntaxHighlighterFactory language="Smarty" implementationClass="ch.erlebnisbank.smarty.SmartySyntaxHighlighterFactory" />
        <colorSettingsPage implementation="ch.erlebnisbank.smarty.SmartyColorSettingsPage" />
        <annotator language="Smarty" implementationClass="ch.erlebnisbank.smarty.SmartyAnnotator" />
        <codeInsight.lineMarkerProvider language="Smarty"
                                        implementationClass="ch.erlebnisbank.smarty.SmartyLineMarkerProvider" />
        <completion.contributor language="Smarty"
                                implementationClass="ch.erlebnisbank.smarty.SmartyCompletionContributor" />
        <psi.referenceContributor language="Smarty"
                                  implementation="ch.erlebnisbank.smarty.SmartyReferenceContributor" />
        <lang.refactoringSupport language="Smarty"
                                 implementationClass="ch.erlebnisbank.smarty.SmartyRefactoringSupportProvider" />
        <lang.findUsagesProvider language="Smarty"
                                 implementationClass="ch.erlebnisbank.smarty.SmartyFindUsagesProvider" />
        <lang.foldingBuilder language="Smarty"
                             implementationClass="ch.erlebnisbank.smarty.SmartyFoldingBuilder" />
        <gotoSymbolContributor implementation="ch.erlebnisbank.smarty.SmartyChooseByNameContributor" />
        <lang.formatter language="Smarty"
                        implementationClass="ch.erlebnisbank.smarty.SmartyFormattingModelBuilder" />
    </extensions>

</idea-plugin>
